{
  "__inputs": [
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "description": "Amazon Managed Grafana CloudWatch data source",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.4.0"
    },
    {
      "type": "datasource",
      "id": "cloudwatch",
      "name": "CloudWatch",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "alias": "API Gateway requests",
          "dimensions": {
            "ApiName": "$api_name",
            "Stage": "$api_stage"
          },
          "metricName": "Count",
          "namespace": "AWS/ApiGateway",
          "period": "60",
          "refId": "A",
          "region": "$region",
          "statistic": "Sum"
        },
        {
          "alias": "ALB requests",
          "dimensions": {
            "LoadBalancer": "$load_balancer"
          },
          "metricName": "RequestCount",
          "namespace": "AWS/ApplicationELB",
          "period": "60",
          "refId": "B",
          "region": "$region",
          "statistic": "Sum"
        }
      ],
      "title": "Traffic Volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Errors",
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "alias": "API Gateway 4xx",
          "dimensions": {
            "ApiName": "$api_name",
            "Stage": "$api_stage"
          },
          "metricName": "4XXError",
          "namespace": "AWS/ApiGateway",
          "period": "60",
          "refId": "A",
          "region": "$region",
          "statistic": "Sum"
        },
        {
          "alias": "API Gateway 5xx",
          "dimensions": {
            "ApiName": "$api_name",
            "Stage": "$api_stage"
          },
          "metricName": "5XXError",
          "namespace": "AWS/ApiGateway",
          "period": "60",
          "refId": "B",
          "region": "$region",
          "statistic": "Sum"
        },
        {
          "alias": "ALB target 4xx",
          "dimensions": {
            "LoadBalancer": "$load_balancer",
            "TargetGroup": "targetgroup/telar-dev-tg/a81346bce9a4895f"
          },
          "metricName": "HTTPCode_Target_4XX_Count",
          "namespace": "AWS/ApplicationELB",
          "period": "60",
          "refId": "C",
          "region": "$region",
          "statistic": "Sum"
        },
        {
          "alias": "ALB target 5xx",
          "dimensions": {
            "LoadBalancer": "$load_balancer",
            "TargetGroup": "targetgroup/telar-dev-tg/a81346bce9a4895f"
          },
          "metricName": "HTTPCode_Target_5XX_Count",
          "namespace": "AWS/ApplicationELB",
          "period": "60",
          "refId": "D",
          "region": "$region",
          "statistic": "Sum"
        }
      ],
      "title": "HTTP Error Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Seconds",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "alias": "API Gateway p95 latency",
          "dimensions": {
            "ApiName": "$api_name",
            "Stage": "$api_stage"
          },
          "metricName": "Latency",
          "namespace": "AWS/ApiGateway",
          "period": "60",
          "refId": "A",
          "region": "$region",
          "statistic": "p95"
        },
        {
          "alias": "ALB p95 target response",
          "dimensions": {
            "LoadBalancer": "$load_balancer",
            "TargetGroup": "targetgroup/telar-dev-tg/a81346bce9a4895f"
          },
          "metricName": "TargetResponseTime",
          "namespace": "AWS/ApplicationELB",
          "period": "60",
          "refId": "B",
          "region": "$region",
          "statistic": "p95"
        }
      ],
      "title": "Edge and Target Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "p95ResponseTime"
          }
        ]
      },
      "targets": [
        {
          "expression": "filter context = \"HTTP\"\n| stats count(*) as requests, avg(responseTime) as avgResponseTime, pct(responseTime, 95) as p95ResponseTime by endpoint\n| sort p95ResponseTime desc\n| limit 50",
          "logGroups": [
            {
              "name": "$log_group"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "$region"
        }
      ],
      "title": "Pino Latency by Endpoint",
      "type": "table"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "requests"
          }
        ]
      },
      "targets": [
        {
          "expression": "filter context = \"HTTP\" and res.statusCode >= 400\n| stats count(*) as requests by endpoint, res.statusCode\n| sort requests desc\n| limit 50",
          "logGroups": [
            {
              "name": "$log_group"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "$region"
        }
      ],
      "title": "Pino HTTP Failures by Endpoint",
      "type": "table"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyJSON": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expression": "fields @timestamp, context, endpoint, reqId, err.type, err.message, @message\n| filter ispresent(err.type)\n| sort @timestamp desc\n| limit 100",
          "logGroups": [
            {
              "name": "$log_group"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "$region"
        }
      ],
      "title": "Application Exceptions",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyJSON": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expression": "fields @timestamp, @message\n| sort @timestamp desc\n| limit 200",
          "logGroups": [
            {
              "name": "$log_group"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "$region"
        }
      ],
      "title": "Backend Logs",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "telar",
    "backend",
    "traffic"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "us-east-1",
          "value": "us-east-1"
        },
        "hide": 0,
        "label": "Region",
        "name": "region",
        "options": [
          {
            "selected": true,
            "text": "us-east-1",
            "value": "us-east-1"
          }
        ],
        "query": "us-east-1",
        "type": "custom"
      },
      {
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "definition": "dimension_values($region,AWS/ApiGateway,Count,ApiName)",
        "includeAll": false,
        "label": "API Gateway",
        "name": "api_name",
        "query": "dimension_values($region,AWS/ApiGateway,Count,ApiName)",
        "refresh": 1,
        "type": "query"
      },
      {
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "definition": "dimension_values($region,AWS/ApiGateway,Count,Stage,{\"ApiName\":\"$api_name\"})",
        "includeAll": false,
        "label": "API Stage",
        "name": "api_stage",
        "query": "dimension_values($region,AWS/ApiGateway,Count,Stage,{\"ApiName\":\"$api_name\"})",
        "refresh": 1,
        "type": "query"
      },
      {
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "definition": "dimension_values($region,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "includeAll": false,
        "label": "Load Balancer",
        "name": "load_balancer",
        "query": "dimension_values($region,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "telar-dev-api-logs",
          "value": "telar-dev-api-logs"
        },
        "hide": 0,
        "label": "Backend Log Group",
        "name": "log_group",
        "options": [
          {
            "selected": true,
            "text": "telar-dev-api-logs",
            "value": "telar-dev-api-logs"
          }
        ],
        "query": "telar-dev-api-logs",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Telar Backend Application",
  "uid": "telar-backend-application",
  "version": 1,
  "weekStart": ""
}
